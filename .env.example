# ==============================================================================
# Survey Management & Live Field Workforce Tracking System - Environment Config
# Copy this file to .env and customize values for your local environment.
# NEVER commit .env to version control.
# ==============================================================================

# Backend Configuration
PROJECT_NAME="Survey Management & Workforce Tracking System"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 18)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="survey_management"
DATABASE_URL="postgresql+psycopg2://postgres:your_postgres_password@localhost:5432/survey_management"

# Security & Authentication (JWT + Argon2id)
# Generate a strong 64-character secret key: `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY="replace_with_a_secure_random_secret_key_for_development"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial System Admin Setup (CLI Bootstrap)
FIRST_SUPERUSER_EMAIL="admin@survey.local"
FIRST_SUPERUSER_PASSWORD="ChangeThisPassword123!"

# CORS Configuration (Comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Redis Configuration (For presence and real-time events in Phase 7)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Frontend Configuration (Vite environment variables start with VITE_)
VITE_API_BASE_URL="http://localhost:8000/api/v1"
